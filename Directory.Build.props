<Project>

  <PropertyGroup Label="Target and language">
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Label="Code quality">
    <!-- Compiler, analyzer and NuGet warnings. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Warnings raised by MSBuild tasks and SDK targets (e.g. Aspire diagnostics) are not covered by the above. -->
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Required for IDE0005 (unnecessary usings) to be reported during build, not only in the IDE. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- XML documentation is not mandatory; the file is generated only for IDE0005. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="NuGet security">
    <!-- Audit direct and transitive packages; with TreatWarningsAsErrors a known vulnerability fails the build. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

  <PropertyGroup Label="CI" Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>