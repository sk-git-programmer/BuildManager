<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are executables running on Microsoft.Testing.Platform. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="NetArchTest.Rules" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referenced so the assemblies are present in the output for IL analysis (NetArchTest). -->
    <ProjectReference Include="..\..\src\BuildManager.Domain\BuildManager.Domain.csproj" />
    <ProjectReference Include="..\..\src\BuildManager.Application\BuildManager.Application.csproj" />
    <ProjectReference Include="..\..\src\BuildManager.Infrastructure\BuildManager.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\BuildManager.Contracts\BuildManager.Contracts.csproj" />
    <ProjectReference Include="..\..\src\BuildManager.Api\BuildManager.Api.csproj" />
    <ProjectReference Include="..\..\src\BuildManager.Web\BuildManager.Web.csproj" />
    <ProjectReference Include="..\..\src\BuildManager.Web.Client\BuildManager.Web.Client.csproj" />
  </ItemGroup>

</Project>