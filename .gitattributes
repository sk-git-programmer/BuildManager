# Normalize all text files to LF in the repository and in the working tree.
# Must stay consistent with end_of_line in .editorconfig (CI runs dotnet format on Linux).
* text=auto eol=lf

# Windows-only scripts require CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary